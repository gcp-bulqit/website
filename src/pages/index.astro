---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base home>
  <section class="hero">
    <h1 data-sim-exclude>{site.nameLines[0]}<br /><em>{site.nameLines[1]}</em></h1>
    <p class="role">{site.role} · {site.location}</p>
    <div class="panel tagline">
      <p style="margin:0">{site.tagline}</p>
    </div>
  </section>
</Base>
