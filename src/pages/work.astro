---
import Base from '../layouts/Base.astro';
import Highlight from '../components/Highlight.astro';
import { experience, earlierExperience } from '../data/site';

// Highlights shown before the "more" disclosure on each role.
const SHOWN = 5;
---

<Base title="Work" chapter="02 / Work" description="Work history.">
  <section class="panel" aria-labelledby="experience">
    <div class="section-head">
      <h2 id="experience">Experience</h2>
      <a class="resume-link" href="/Gleb_Pavlov_Resume.pdf" target="_blank" rel="noopener">
        Résumé (PDF)<span class="visually-hidden"> (opens in a new tab)</span> ↗
      </a>
    </div>
    <ol class="entries">
      {
        experience.map((role) => (
          <li class="entry role">
            <span class="year">
              {role.start}
              <br />
              {role.end}
            </span>
            <div>
              <h3>{role.title}</h3>
              <p class="org">
                {role.company} · {role.location}
                {role.altTitle && <span class="muted"> · {role.altTitle}</span>}
              </p>
              {role.context && <p class="muted context">{role.context}</p>}
              <ul class="highlights">
                {role.highlights.slice(0, SHOWN).map((h) => (
                  <Highlight item={h} />
                ))}
              </ul>
              {role.highlights.length > SHOWN && (
                <details>
                  <summary>{role.highlights.length - SHOWN} more</summary>
                  <ul class="highlights">
                    {role.highlights.slice(SHOWN).map((h) => (
                      <Highlight item={h} />
                    ))}
                  </ul>
                </details>
              )}
            </div>
          </li>
        ))
      }
    </ol>
    <p class="muted earlier"><strong>Earlier:</strong> {earlierExperience}</p>
  </section>
</Base>
