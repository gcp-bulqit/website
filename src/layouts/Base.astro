---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SlimeField from '../components/SlimeField.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';
import { site, nav } from '../data/site';
import { palettes, defaultPalette, paletteCss } from '../data/palettes';

const paletteNames = palettes.map((p) => p.name);

interface Props {
  title?: string;
  description?: string;
  chapter?: string;
  home?: boolean;
  noindex?: boolean; // keep this page out of search results
}
const { title, description = site.tagline, chapter, home = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name}: ${site.role}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, site.url);
// Link-preview image (LinkedIn, Slack, iMessage, X): 1200x630 layout rendered at 2x so text survives re-compression. Platforms cache it by URL: give a new image a new filename.
const ogImage = new URL('/og-card-2.jpg', site.url);
---

<!doctype html>
<html lang="en" data-palette={defaultPalette}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {/* A noindex page (404, hidden drafts) shouldn't name a canonical URL: on the 404 it would be the bad URL. */}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="pavlovsdogma.com" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="Gleb Pavlov, Software Developer: I build systems, tools, and the occasional website. Slime-mold trails glow green, yellow and red on the right." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0c0f0d" />
    <!-- Persisted across client-side navigations: re-inserting it on every page swap would
         re-preload an already-loaded font and trigger an "unused preload" console warning. -->
    <link
      rel="preload"
      href="/fonts/ProggyCleanNerdFontPropo.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      transition:persist="font-preload"
    />
    <style is:inline set:html={paletteCss()}></style>
    <script is:inline define:vars={{ paletteNames }}>
      // Runs once. The client router replaces <html> attributes on every navigation, so the saved
      // theme and palette are re-applied after each swap.
      const applyPrefs = () => {
        const root = document.documentElement;
        try {
          const t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') root.dataset.theme = t;
          const p = localStorage.getItem('palette');
          if (p && paletteNames.includes(p)) root.dataset.palette = p;
        } catch {}
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', getComputedStyle(root).getPropertyValue('--bg').trim());
      };
      applyPrefs();
      document.addEventListener('astro:after-swap', applyPrefs);
    </script>
    <!-- Client-side navigation keeps the simulation layer (transition:persist) alive between pages. -->
    <ClientRouter />
  </head>
  <body class:list={{ home }}>
    <a class="skip-link" href="#content">Skip to content</a>
    <SlimeField />

    <div class="page">
      <header class="site-header">
        <nav aria-label="Main">
          <ol class="nav">
            <li>
              <a class="home-tab" href="/" aria-current={path === '/' ? 'page' : undefined} aria-label={`${site.initials}, ${site.name}, home`}>
                {site.initials}
              </a>
            </li>
            {
              nav.map((item, i) => (
                <li>
                  <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                    <span class="num">{String(i + 1).padStart(2, '0')}</span>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle color theme">
          <span class="nf" aria-hidden="true">{"\uf042"}</span>
        </button>
      </header>

      <main id="content">
        {
          !home && (
            <header class="page-head">
              {chapter && <p class="chapter">{chapter}</p>}
              <h1 data-sim-exclude>{title}</h1>
            </header>
          )
        }
        <slot />
      </main>

      {/* The home page places the footer itself, under the tagline. */}
      {!home && <SiteFooter />}
    </div>

    <script>
      // Show the sticky header's band once the page has scrolled under it. Scroll events don't
      // bubble, so listen in the capture phase; this also covers each new .page after navigation.
      document.addEventListener(
        'scroll',
        (e) => {
          const el = e.target;
          if (!(el instanceof HTMLElement) || !el.classList.contains('page')) return;
          el.querySelector('.site-header')?.classList.toggle('is-stuck', el.scrollTop > 4);
        },
        { capture: true, passive: true },
      );

      // Delegated: the header (and this button) is replaced on every client-side navigation.
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('#theme-toggle')) return;
        const root = document.documentElement;
        const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', getComputedStyle(root).getPropertyValue('--bg').trim());
      });
    </script>
    <!-- Vercel Web Analytics + Speed Insights. In <body> (not persisted) so each client-side
         navigation renders a fresh element and records a page view for the new route. -->
    <Analytics />
    <SpeedInsights />
  </body>
</html>
