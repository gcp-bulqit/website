---
// The simulation layer: a fixed canvas behind the page plus the frame and HUD drawn over it.
---

<!-- Persisted across client-side navigations, so the simulation keeps running between pages. -->
<div id="sim-layer" transition:persist="sim">
  <canvas id="slime" aria-hidden="true"></canvas>
  <div class="frame" aria-hidden="true">
    <span class="corner tr" id="sim-readout">physarum · loading</span>
    <span class="corner bl">move = attract · hold = repel</span>
  </div>
  <div class="sim-controls" role="group" aria-label="Background simulation">
    <button type="button" id="sim-toggle" aria-pressed="false">Pause</button>
    <button type="button" id="sim-reset">Reseed</button>
    <button type="button" id="sim-focus" aria-pressed="false" title="Hide the page content to watch the simulation">View</button>
    <button type="button" id="sim-tune" aria-expanded="false" aria-controls="tune-panel" title="Adjust the simulation's parameters">Tune</button>
  </div>
</div>

<script>
  import { createPhysarum, MAX_SPECIES, type Palette } from '../scripts/physarum';

  const canvas = document.getElementById('slime') as HTMLCanvasElement;
  const readout = document.getElementById('sim-readout')!;
  const toggle = document.getElementById('sim-toggle') as HTMLButtonElement;
  const reset = document.getElementById('sim-reset') as HTMLButtonElement;
  const focus = document.getElementById('sim-focus') as HTMLButtonElement;
  const tuneBtn = document.getElementById('sim-tune') as HTMLButtonElement;

  const hexToRgb = (hex: string) => {
    const h = hex.trim().replace('#', '');
    const n = parseInt(h.length === 3 ? h.replace(/./g, '$&$&') : h, 16);
    return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
  };
  const readPalette = (): Palette => {
    const s = getComputedStyle(document.documentElement);
    return {
      stops: [s.getPropertyValue('--sim-bg'), ...s.getPropertyValue('--sim-stops').trim().split(/\s+/)]
        .filter(Boolean)
        .map(hexToRgb),
    };
  };

  // Each URL path gets its own food-node layout (stable on revisits).
  const pathSeed = (path: string) => {
    let h = 2166136261;
    for (const ch of path.replace(/\/$/, '') || '/') h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
    return h >>> 0;
  };

  // Created idle: it starts once the page title has been measured (see start() below).
  // URL switches, read once on the first full load (this layer persists across navigation):
  //   ?nogl    skip WebGL entirely, to preview the fallback a browser without WebGL2 gets
  //   ?paused  start paused: seed once, settle a still frame, and wait for Play
  //   ?split[=seconds]  start with 4 species on the standard settings, let them settle for that
  //            many seconds of animation (default 10), then turn species repel to its maximum
  //   ?outline=dog.svg  follow an image's outline instead of the food nodes (prototype). The path is
  //            resolved from the site root ("dog.svg" and "/dog.svg" are the same file); only images
  //            on this site are allowed, since the canvas can't read pixels from other origins.
  const urlFlags = new URLSearchParams(location.search);
  const noGl = urlFlags.has('nogl');
  const startPaused = urlFlags.has('paused');
  const splitAfter = urlFlags.has('split') ? Math.max(0, Number(urlFlags.get('split')) || 10) : null;
  const sim = noGl ? null : createPhysarum(canvas, readPalette(), {
    nodeSeed: pathSeed(location.pathname),
    start: false,
    onError: () => {
      // Shaders failed to compile (reported asynchronously): fall back to the static gradient.
      sim?.setRunning(false);
      document.documentElement.classList.add('no-sim');
      readout.textContent = 'physarum · webgl2 unavailable';
    },
  });

  // The client router replaces <html> attributes on navigation; restore the classes this layer owns.
  const rootClasses = new Set<string>();
  const setRootClass = (name: string, on: boolean) => {
    on ? rootClasses.add(name) : rootClasses.delete(name);
    document.documentElement.classList.toggle(name, on);
  };
  document.addEventListener('astro:after-swap', () => {
    for (const c of rootClasses) document.documentElement.classList.add(c);
  });

  if (!sim) {
    setRootClass('no-sim', true);
    readout.textContent = 'physarum · webgl2 unavailable';
    toggle.disabled = reset.disabled = focus.disabled = tuneBtn.disabled = true;
  } else {
    // Dev builds only: expose the simulation for tuning from the console or test scripts.
    if (import.meta.env.DEV) (window as unknown as { __sim: typeof sim }).__sim = sim;
    const updateReadout = () => {
      const fps = !sim.isRunning() ? ' · paused' : sim.isActive() ? ` · ${Math.round(sim.fps)} fps` : ' · idle';
      readout.textContent = `physarum · ${sim.agentCount.toLocaleString()} agents${fps}`;
    };
    updateReadout();
    setInterval(updateReadout, 1000);

    const setLabel = () => {
      toggle.textContent = sim.isRunning() ? 'Pause' : 'Play';
      toggle.setAttribute('aria-pressed', String(!sim.isRunning()));
    };
    toggle.addEventListener('click', () => {
      sim.setRunning(!sim.isRunning());
      setLabel();
      updateReadout();
    });
    reset.addEventListener('click', () => sim.reset());
    focus.addEventListener('click', () => {
      const on = !rootClasses.has('sim-focus');
      setRootClass('sim-focus', on);
      focus.setAttribute('aria-pressed', String(on));
      focus.textContent = on ? 'Back' : 'View';
    });

    // Reduced motion: render a settled still frame instead of animating.
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Keep food nodes out from under elements marked data-sim-exclude (the home page title).
    // Measures the text's line boxes, not the block, and uses positions as if the page were
    // scrolled to the top, since nodes are fixed to the viewport.
    const measureExclusions = () => {
      const scroll = document.querySelector('.page')?.scrollTop ?? 0;
      const rects = [];
      for (const el of document.querySelectorAll('[data-sim-exclude]')) {
        const range = document.createRange();
        range.selectNodeContents(el);
        for (const r of range.getClientRects()) {
          if (r.width && r.height) rects.push({ left: r.left, right: r.right, top: r.top + scroll, bottom: r.bottom + scroll });
        }
      }
      return rects;
    };
    // Only the home page keeps its title clear: no nodes under it, and the slime is repelled.
    // On other pages nodes and slime may form around and over the title.
    const updateExclusions = (rebuild = true) => {
      const home = location.pathname.replace(/\/$/, '') === '';
      sim.setExclusions(home ? measureExclusions() : [], { repel: home, rebuild });
    };

    // Every full page load starts with a Reseed laid out for this page's title: measure the title
    // (after the pixel font loads, so it's at its real size), place the nodes around it, then
    // seed and start. Nothing is drawn before that, so the nodes never jump on load. The reseed's
    // quiet period also keeps the cursor's position on arrival from shaping the first network.
    // ?split: 4 species with the standard settings, then after `seconds` of animation (time paused
    // or in a background tab doesn't count) every cross-species attraction goes to -SPLIT_REPEL,
    // the Tune window's "species repel" maximum, and the species push apart.
    const SPLIT_REPEL = 1.5;
    const startSplit = (seconds: number) => {
      sim.params.species = 4;
      let ran = 0;
      let last = performance.now();
      const timer = setInterval(() => {
        const now = performance.now();
        if (sim.isActive()) ran += now - last;
        last = now;
        if (ran < seconds * 1000) return;
        clearInterval(timer);
        sim.params.attraction = sim.params.attraction.map((x, i) => (Math.floor(i / MAX_SPECIES) === i % MAX_SPECIES ? x : -SPLIT_REPEL));
        tuner?.then((t) => t.sync());
      }, 250);
    };

    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      updateExclusions(false); // reset() below builds the nodes
      if (splitAfter !== null) startSplit(splitAfter); // also with ?outline: 4 species along the outline
      if (!reduced && !startPaused) sim.setRunning(true);
      sim.reset();
      setLabel();
      updateReadout();
    };
    const outlineParam = urlFlags.get('outline');
    const outlineUrl = outlineParam ? new URL(outlineParam, `${location.origin}/`) : null;
    if (outlineUrl && outlineUrl.origin !== location.origin) console.warn(`physarum: outline must be on this site: ${outlineParam}`);
    const outlineSrc = outlineUrl?.origin === location.origin ? outlineUrl.href : null;
    const outlineReady =
      outlineSrc
        ? (() => {
            const img = new Image();
            img.src = outlineSrc;
            return img
              .decode()
              .then(() => {
                // Tuned on a real GPU: one species and a light trail keep the line crisp (the site's
                // normal deposit saturates it to a flat band) while the threads pushed out of the
                // shape's interior stay visible.
                Object.assign(sim.params, { species: 1, deposit: 0.03 });
                sim.setOutline(img);
              })
              .catch(() => console.warn(`physarum: could not load outline ${outlineSrc}`));
          })()
        : Promise.resolve();
    const fontsReady =
      document.fonts.status === 'loaded' ? Promise.resolve() : Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 400))]);
    Promise.all([fontsReady, outlineReady]).then(start);
    // Set when a client-side navigation starts; the new page's load finishes it (see below).
    let navigating = false;
    document.addEventListener('astro:page-load', () => {
      if (!started) return;
      updateExclusions(); // builds the new page's node layout (disturb() leaves that to us)
      if (navigating && reduced) {
        // Reduced motion: settle the still frame onto the new layout, but only after the new
        // page has painted, so the simulation steps don't compete with it.
        requestAnimationFrame(() => setTimeout(() => sim.settle(180), 0));
      }
      navigating = false;
    });
    let exclusionTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(exclusionTimer);
      exclusionTimer = window.setTimeout(updateExclusions, 150);
    });
    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      if (sim.isRunning()) return;
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => sim.reset(), 200);
    });

    const repaint = () => sim.setPalette(readPalette());
    new MutationObserver(repaint).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'data-palette'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', repaint);

    // On client-side navigation, push the network onto new paths. The shockwave starts at the
    // link that was clicked, or the centre of the screen for back/forward and keyboard navigation.
    const press = { x: 0, y: 0, at: -Infinity };
    window.addEventListener('pointerdown', (e) => Object.assign(press, { x: e.clientX, y: e.clientY, at: performance.now() }), {
      passive: true,
    });
    document.addEventListener('astro:before-preparation', (e) => {
      const to = (e as Event & { to: URL }).to;
      if (to.pathname === location.pathname) return;
      const recent = performance.now() - press.at < 1000;
      navigating = true;
      // No settling here: when paused the frame stays frozen (the disturbance plays on Play), and
      // with reduced motion the page-load handler settles after the new page has painted.
      sim.disturb({ nodeSeed: pathSeed(to.pathname), ...(recent ? { x: press.x, y: press.y } : {}), rebuild: false, settle: false });
    });

    // Tune window: loaded on first use. ?tune in the URL (on any page) opens it too.
    let tuner: Promise<import('../scripts/tune').Tuner> | null = null;
    const getTuner = () =>
      (tuner ??= import('../scripts/tune').then(({ mountTuner }) =>
        mountTuner(sim, (open) => {
          tuneBtn.setAttribute('aria-expanded', String(open));
          if (!open) tuneBtn.focus();
        }),
      ));
    tuneBtn.addEventListener('click', () => getTuner().then((t) => t.toggle()));
    const maybeTune = () => {
      // After any ?outline image has loaded, so the window includes the outline sliders.
      if (new URLSearchParams(location.search).has('tune')) outlineReady.then(getTuner).then((t) => t.open());
    };
    maybeTune();
    document.addEventListener('astro:page-load', maybeTune);
  }
</script>
